# Environment configuration for DocuMind Phase 2A

# Backend Configuration
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
PROJECT_NAME="DocuMind Document Intelligence"

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database Configuration
# Default to SQLite for local development:
DATABASE_URL=sqlite+aiosqlite:///./documind.db
# When using PostgreSQL via Docker Compose:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/documind

# Storage Configuration
UPLOAD_DIR=storage/uploads
MAX_FILE_SIZE_MB=15

# ML & OCR Pipeline Configuration (Phase 2A)
DEFAULT_EXTRACTION_METHOD=TESSERACT_BASELINE
ENABLE_ML_INFERENCE=True

# Path to Tesseract binary (if not in system PATH):
# Windows example:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux example:
# TESSERACT_CMD=/usr/bin/tesseract

OCR_PDF_DPI=300
OCR_MAX_PAGES=5
OCR_CONFIDENCE_THRESHOLD=0.60
DEFAULT_DATE_FORMAT_ORDER=DMY
LAYOUTLMV3_CHECKPOINT_DIR=checkpoints/layoutlmv3-sroie-best

# Human-in-the-Loop Review & Preview Configuration (Phase 3A)
REVIEW_CONFIDENCE_THRESHOLD=0.75
PREVIEW_MAX_PDF_PAGES=20
PREVIEW_RENDER_DPI=150
DEFAULT_REVIEWER_ID=local-anonymous
