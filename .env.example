# DocuMind Environment Configuration Template
# Copy to .env and customize for local development or production.

# Runtime Environment ("development" | "production")
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="DocuMind Document Intelligence"
LOG_FORMAT=json

# Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Authentication & Security (REQUIRED >= 32 random chars in production)
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SAMESITE=lax
# COOKIE_SECURE automatically enabled when ENVIRONMENT=production or HTTPS detected
LOGIN_RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_FAIL_CLOSED=false
TRUST_PROXY_HEADERS=false
ALLOW_VIEWER_SELF_REGISTRATION=false

# Database (PostgreSQL recommended for Docker/production; SQLite supported for local development)
POSTGRES_USER=documind
POSTGRES_PASSWORD=documind_dev_password
POSTGRES_DB=documind
DATABASE_URL=sqlite+aiosqlite:///./documind.db
SYNC_DATABASE_URL=sqlite:///./documind.db

# Redis & Celery Async Worker
REDIS_PASSWORD=documind_dev_redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_SOFT_TIME_LIMIT=120
CELERY_TASK_TIME_LIMIT=180
CELERY_WORKER_MAX_TASKS_PER_CHILD=50
STALE_JOB_TIMEOUT_SECONDS=300
MAX_JOB_ATTEMPTS=3
MAX_CONCURRENT_GPU_INFERENCE=1
PRELOAD_LAYOUTLMV3_ON_WORKER_START=false
FLOWER_BASIC_AUTH=admin:change_me

# Storage & Media Limits
UPLOAD_DIR=storage/uploads
MAX_FILE_SIZE_MB=15
MAX_IMAGE_PIXELS=40000000
MAX_PDF_PAGES_HARD_LIMIT=50

# ML & OCR Extraction Settings
DEFAULT_EXTRACTION_METHOD=TESSERACT_BASELINE
ENABLE_ML_INFERENCE=true
TESSERACT_CMD=
OCR_PDF_DPI=300
OCR_MAX_PAGES=5
OCR_CONFIDENCE_THRESHOLD=0.60
DEFAULT_DATE_FORMAT_ORDER=DMY
LAYOUTLMV3_CHECKPOINT_DIR=checkpoints/layoutlmv3-sroie-best

# Human-in-the-Loop Review Settings
REVIEW_CONFIDENCE_THRESHOLD=0.75
PREVIEW_MAX_PDF_PAGES=20
PREVIEW_RENDER_DPI=150
DEFAULT_REVIEWER_ID=local-anonymous
